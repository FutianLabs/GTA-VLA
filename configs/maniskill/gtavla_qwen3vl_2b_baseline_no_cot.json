{
  "_name_or_path": "gtavla",
  "model_type": "gtavla",
  "architectures": ["GTAVLA"],
  "auto_map": {
    "AutoConfig": "configuration_gtavla.GTAVLAConfig",
    "AutoModel": "modeling_gtavla.GTAVLA"
  },

  "vlm_backbone_type": "qwen3_vl",
  "qwen3_pretrained": "Qwen/Qwen3-VL-2B-Instruct",
  "qwen3_torch_dtype": "bfloat16",
  "qwen3_use_flash_attn": true,

  "vlm_use_multi_layer": true,
  "vlm_multi_layer_indices": [-4, -3, -2, -1],

  "action_mode": "ee6d",
  "use_proprio": true,
  "num_actions": 30,
  "num_views": 2,
  "hidden_size": 1024,
  "depth": 24,
  "num_heads": 16,
  "mlp_ratio": 4.0,
  "num_domains": 30,
  "len_soft_prompts": 32,
  "dim_time": 32,
  "max_len_seq": 512,
  "use_hetero_proj": false,
  "use_multilayer_proj": true,
  "proj_num_layers": 2,
  "proj_hidden_size": 1536,
  "proj_dropout": 0.1,
  "use_soft_prompt": false,
  "use_cot_training": false,
  "use_interaction_augmentation": false,
  "num_diffusion_samples": 4
}
