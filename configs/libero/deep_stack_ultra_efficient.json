{
  "_name_or_path": "gtavla",
  "model_type": "gtavla",
  "architectures": ["GTAVLA"],
  "auto_map": {
    "AutoConfig": "configuration_gtavla.GTAVLAConfig",
    "AutoModel": "modeling_gtavla.GTAVLA"
  },

  "vlm_backbone_type": "qwen3_vl",
  "qwen3_pretrained": "Qwen/Qwen3-VL-2B-Instruct",
  "qwen3_torch_dtype": "bfloat16",
  "qwen3_use_flash_attn": true,

  "_comment_deep_stack": "Ultra memory-efficient: last_n + reduced heads + smaller batch recommended",
  "_comment_memory": "Fits on 20-24GB GPUs with batch_size=4",
  "_comment_training": "Use gradient_accumulation_steps=2 to maintain effective batch size",
  "use_deep_stack": true,
  "deep_stack_layer_mapping": "last_n",
  "deep_stack_cross_attn_heads": 4,
  "deep_stack_cross_attn_drop": 0.1,

  "action_mode": "ee6d",
  "control_mode": "abs",
  "use_proprio": true,
  "num_actions": 30,

  "hidden_size": 1024,
  "depth": 24,
  "num_heads": 16,
  "mlp_ratio": 4.0,
  "num_domains": 30,
  "len_soft_prompts": 16,
  "dim_time": 32,
  "max_len_seq": 384,
  "use_hetero_proj": false,
  "soft_prompt_length": 16,
  "use_multilayer_proj": true,
  "proj_num_layers": 2,
  "proj_hidden_size": 1536,
  "proj_dropout": 0.1
}

