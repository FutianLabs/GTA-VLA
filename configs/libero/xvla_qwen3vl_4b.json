  "num_actions": 30,

  "hidden_size": 1024,
  "depth": 24,
  "num_heads": 16,
  "mlp_ratio": 4.0,
  "num_domains": 30,
  "len_soft_prompts": 32,
  "dim_time": 32,
  "max_len_seq": 512,
  "use_hetero_proj": false,
  "soft_prompt_length": 32
